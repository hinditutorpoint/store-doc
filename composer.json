{
    "name": "store-doc/laravel-storage-driver",
    "description": "Laravel Storage Driver for Store-Doc S3-compatible storage service with complete Storage facade support",
    "version": "2.0.0",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "laravel",
        "storage",
        "filesystem",
        "flysystem",
        "s3",
        "store-doc"
    ],
    "authors": [
        {
            "name": "Store-Doc Team",
            "email": "support@store-doc.com"
        }
    ],
    "require": {
        "php": "^8.3",
        "illuminate/support": "^11.0|^12.0|^13.0",
        "illuminate/filesystem": "^11.0|^12.0|^13.0",
        "league/flysystem": "^3.0",
        "guzzlehttp/guzzle": "^7.0"
    },
    "autoload": {
        "psr-4": {
            "StoreDoc\\Laravel\\Storage\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "StoreDoc\\Laravel\\Storage\\Tests\\": "tests/"
        }
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0|^12.0"
    },
    "scripts": {
        "test": "phpunit"
    },
    "extra": {
        "laravel": {
            "providers": [
                "StoreDoc\\Laravel\\Storage\\StoreDocServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}