# Files that should not be shipped in the Composer dist archive.
# Only the runtime package (src/, composer.json, LICENSE, README.md and the
# consumer facing guides) is published.
/.github            export-ignore
/.gitattributes     export-ignore
/.gitignore         export-ignore
/phpunit.xml.dist   export-ignore
/tests              export-ignore
/test-*.php         export-ignore
/PACKAGE_ENHANCEMENT_SUMMARY.md export-ignore
/QUICKSTART.md      export-ignore
/TESTING.md         export-ignore
